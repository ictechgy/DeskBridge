+        guard highest - sequence < UInt32(Self.capacity) else { return false }
+        let slot = Int(sequence % UInt32(Self.capacity))
+        return received[slot / UInt64.bitWidth] & (UInt64(1) << (slot % UInt64.bitWidth)) == 0
+    }
